        "subtitle": "Passive Voice",
        "badge": "Passive",
        "usage": "نستخدمه حين يكون المفعول به أهم من الفاعل، أو حين لا نعرف الفاعل أو لا نريد ذكره.",
        "keywords": [
          {
            "f": "المضارع البسيط",
            "b": "am / is / are + V3"
          },
          {
            "f": "المضارع المستمر",
            "b": "am / is / are + being + V3"
          },
          {
            "f": "الماضي البسيط",
            "b": "was / were + V3"
          },
          {
            "f": "الماضي التام",
            "b": "had + been + V3"
          },
          {
            "f": "المستقبل",
            "b": "will + be + V3"
          }
        ],
        "formulas": [
          {
            "subj": "مضارع",
            "form": "am/is/are + V3",
            "ex": "English <strong>is spoken</strong> worldwide."
          },
          {
            "subj": "ماضٍ",
            "form": "was/were + V3",
            "ex": "The pyramids <strong>were built</strong> thousands of years ago."
          },
          {
            "subj": "مستقبل",
            "form": "will + be + V3",
            "ex": "The report <strong>will be sent</strong> tomorrow."
          }
        ],
        "exception": {
          "title": "⚠️ كيف تحول من المعلوم للمجهول؟",
          "body": "المفعول به → فاعل جديد | الفاعل → by + ... (اختياري)<br>\n                Active:  They <u>built</u> this bridge in 1990.<br>\n                Passive: This bridge <strong>was built</strong> in 1990 (by them)."
        },
        "practice": [
          {
            "q": "The Mona Lisa …… by Leonardo da Vinci.",
            "opts": [
              "painted",
              "is painted",
              "was painted",
              "has painted"
            ],
            "c": 2,
            "expl": "حدث في الماضي + مبني للمجهول: <strong>was painted</strong>.",
            "id": "q_grammar_11_001"
          },
          {
            "q": "Many emails …… every day in the company.",
            "opts": [
              "send",
              "sent",
              "are sent",
              "were sent"
            ],
            "c": 2,
            "expl": "كل يوم = مضارع + جمع (emails) → <strong>are sent</strong>.",
            "id": "q_grammar_11_002"
          }
        ]
      },
