# ── Database ──────────────────────────────────────────────────
# يطابق docker-compose.yml (المنفذ 5433 لتفادي التعارض مع Postgres محلي على 5432)
DATABASE_URL="postgresql://ayed:ayed_local_dev@localhost:5433/ayed_academy?schema=public"

# ── Server ────────────────────────────────────────────────────
PORT=3100
NODE_ENV=development
# أصول إضافية مسموح لها بالوصول للـ API، مفصولة بفاصلة (خادم Vite أثناء التطوير)
CORS_ORIGIN="http://localhost:5173"

# ── Auth ──────────────────────────────────────────────────────
# ولّد واحداً جديداً: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# حساب الأدمن الأول — يُنشأ مرة واحدة عند تشغيل سكريبت النقل / db:seed
ADMIN_EMAIL="admin@ayedacademy.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Ayed"

# ── Uploads ───────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=20
